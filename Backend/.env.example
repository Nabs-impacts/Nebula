# --- Base de données ---
DATABASE_URL=postgresql://nebula_user:changeme@localhost:5432/nebula_db

# --- Sécurité / Auth ---
SECRET_KEY=changeme-generate-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Redis / File d'attente ---
REDIS_URL=redis://localhost:6379/0

# --- Brevo (email) ---
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=contact@tenora-digital.store
BREVO_SENDER_NAME=Tenora

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_API_VERSION=v20.0

# --- IA (génération des messages) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# --- Divers ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
