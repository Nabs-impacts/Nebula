# --- Base de données ---
DATABASE_URL=postgresql://nebula_user:changeme@localhost:5432/nebula_db

# --- Sécurité / Auth ---
SECRET_KEY=changeme-generate-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Redis / File d'attente ---
REDIS_URL=redis://localhost:6379/0

# --- Brevo (email) ---
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=contact@tenora-digital.store
BREVO_SENDER_NAME=Tenora
BREVO_REPLY_TO=tenorashopne@gmail.com

# --- Réception des réponses (IMAP) ---
IMAP_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=tenorashopne@gmail.com
IMAP_PASSWORD=mot-de-passe-application-gmail
IMAP_FOLDER=INBOX
IMAP_POLL_MINUTES=5
IMAP_LOOKBACK_DAYS=7

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_API_VERSION=v20.0

# --- Identité de l'agence (prompts + signature) ---
AGENCE_NOM=Tenora
AGENCE_SIGNATURE=L'équipe Tenora
AGENCE_TELEPHONE_1=87773982
AGENCE_TELEPHONE_2=80181172
AGENCE_SITE_WEB=https://tenora-digital.store
# Numéro WhatsApp affiché dans les emails (format local ou international). Vide = ligne masquée.
AGENCE_WHATSAPP=
AGENCE_PREUVE_CLIENTS=plus d'une cinquantaine de clients satisfaits
AGENCE_ARGUMENT_PRIX=un prix imbattable
AGENCE_ADRESSE=Niamey, Niger
AGENCE_LOGO_URL=http://localhost:5173/branding/nebula-logo.png
AGENCE_LOGO_BLANC_URL=http://localhost:5173/branding/nebula-logo-blanc.png
AGENCE_ICONE_URL=http://localhost:5173/branding/nebula-icone.png
AGENCE_CTA_LABEL=Voir la maquette
AGENCE_CTA_URL=https://tenora-digital.store

# --- IA (génération des messages) ---
IA_PRIORITAIRE=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# --- Divers ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
